# App-only rootless image (SearXNG runs separately; see Dockerfile for
# the all-in-one build). Runs as UID 10001 with GID 0 so it satisfies
# Kubernetes runAsNonRoot (numeric user) and OpenShift's random-UID
# restricted SCC alike.

# ---- builder ----
FROM registry.fedoraproject.org/fedora:44 AS builder

# Node 24 from NodeSource (Fedora 44 ships Node 22 as the default).
RUN curl -fsSL https://rpm.nodesource.com/setup_24.x | bash - \
 && dnf -y install nodejs python3 python3-pip make gcc-c++ git \
 && npm install -g yarn \
 && dnf clean all

WORKDIR /build

# Install deps first so they cache independently of source changes.
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 600000

# The scraper launches chromium-headless-shell through Playwright.
# Install it here and copy the result, rather than downloading into
# the runtime image where it would need network and a writable HOME.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
RUN yarn playwright install --only-shell chromium \
 && chmod -R a+rX /opt/pw-browsers

# Build the Next.js standalone bundle (output: 'standalone' in next.config.mjs).
COPY . .
RUN yarn build

# ---- runtime ----
FROM registry.fedoraproject.org/fedora:44 AS runtime

# System libs for headless Chromium; the browser itself comes from the
# builder stage. DB migrations run at startup via src/instrumentation.ts.
RUN curl -fsSL https://rpm.nodesource.com/setup_24.x | bash - \
 && dnf -y install nodejs \
      alsa-lib atk cups-libs libdrm mesa-libgbm \
      libXcomposite libXdamage libXfixes libXrandr libxkbcommon \
      nspr nss pango \
 && dnf clean all \
 && install -d -o 10001 -g 0 -m 0750 /home/vane \
 && install -d -o 10001 -g 0 -m 0770 /home/vane/data

# Owner=10001 + group=0 with the default COPY modes (0755 dirs / 0644
# files) is enough for a random high UID with GID 0 in supplemental
# groups: group 0 already reads files and traverses dirs.
WORKDIR /home/vane
COPY --from=builder --chown=10001:0 /build/.next/standalone ./
COPY --from=builder --chown=10001:0 /build/.next/static ./.next/static
COPY --from=builder --chown=10001:0 /build/public ./public
COPY --from=builder --chown=10001:0 /build/drizzle ./drizzle
COPY --from=builder --chown=10001:0 /opt/pw-browsers /opt/pw-browsers

USER 10001
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
EXPOSE 3000
CMD ["node", "server.js"]
